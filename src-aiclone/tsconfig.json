{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmit": true,
    "rootDir": ".."
  },
  "include": ["./**/*.ts", "../src/context-engine/types.ts"],
  "exclude": ["./**/*.test.ts"]
}
